# =====================================================================
# DCITC content backend — environment variables
# =====================================================================
# Copy to .env and fill in. .env is gitignored — NEVER commit real keys.
#
# Which keys are safe where:
#   SUPABASE_URL + SUPABASE_ANON_KEY        → public, safe for the browser
#   SUPABASE_SERVICE_ROLE_KEY               → SERVER-SIDE ONLY (build scripts).
#                                             Never put it in HTML/JS/CSS,
#                                             never in Cloudflare Pages'
#                                             public env vars, never in git.
#
# With no .env at all the site builds exactly as before, from the local
# content/ files (offline mode).

# Project URL — Supabase dashboard → Project Settings → API
SUPABASE_URL=

# Public anon key — safe for the browser (used by /admin/). RLS policies
# are the actual security boundary for this key.
SUPABASE_ANON_KEY=

# Service-role key — BYPASSES RLS. Used only by scripts/build.js and
# scripts/import-content.js to read content at build time. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
